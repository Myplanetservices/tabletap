# TableTap environment. Copy to .env for local runs; set the same keys in your
# host (Vercel → Project Settings → Environment Variables) for deploys.
# Never commit real values.

# --- Neon Postgres (written by `neon env pull` / `neon deploy`) -------------
# Pooled URL for the app, direct (unpooled) URL for migrations.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require"

# --- Email (Resend) ---------------------------------------------------------
# API key from https://resend.com/api-keys and a sender on a verified domain.
RESEND_API_KEY=""
EMAIL_FROM="TableTap <invites@yourdomain.com>"
# Optional
EMAIL_REPLY_TO=""

# --- Local server -----------------------------------------------------------
PORT=8000
